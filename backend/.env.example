# Server (hosting platforms may set PORT instead; API_PORT takes precedence)
API_PORT=5000
NODE_ENV=development

# MongoDB. Leave empty in development to use a built-in local database
# (stored in backend/.data). Set it for production, e.g. a MongoDB Atlas URI.
MONGODB_URI=

# Long random string used to sign login sessions. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Who can sign up (comma-separated email domains).
ALLOWED_EMAIL_DOMAINS=student.nitw.ac.in

# These emails become admins automatically when they sign up or log in.
# They may use any domain (e.g. faculty addresses).
ADMIN_EMAILS=

# File storage: "local" (backend/uploads, dev only) or "cloudinary".
STORAGE_DRIVER=local
# Cloudinary console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (verification codes at sign-up), sent through Brevo's HTTPS API because Render's
# free plan blocks SMTP. Get a key at app.brevo.com > SMTP & API > API Keys, and verify the
# sender address under Senders. Empty = development prints codes to the console, and
# production signs people up without a code. Admins can switch verification on/off in the console.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=ExamStore

# Max upload size in MB. Defaults to 10 with Cloudinary (free-plan limit), 25 otherwise.
MAX_UPLOAD_MB=
